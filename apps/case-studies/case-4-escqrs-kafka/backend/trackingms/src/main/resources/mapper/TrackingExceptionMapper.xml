<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.trackingms.infrastructure.repositories.mybatis.TrackingExceptionMapper">

    <resultMap id="trackingExceptionResultMap"
               type="com.example.trackingms.domain.projections.TrackingExceptionView">
        <id property="exceptionId" column="exception_id"/>
        <result property="trackingNumber" column="tracking_number"/>
        <result property="exceptionType" column="exception_type"/>
        <result property="occurredAt" column="occurred_at"/>
        <result property="occurredUnlocode" column="occurred_unlocode"/>
        <result property="description" column="description"/>
        <result property="responseStatus" column="response_status"/>
        <result property="resolution" column="resolution"/>
        <result property="resolvedAt" column="resolved_at"/>
        <result property="escalated" column="escalated"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insertException">
        INSERT INTO tracking_exception (
            exception_id,
            tracking_number,
            exception_type,
            occurred_at,
            occurred_unlocode,
            description,
            response_status,
            escalated,
            created_at,
            updated_at
        ) VALUES (
            #{exceptionId},
            #{trackingNumber},
            #{exceptionType},
            #{occurredAt},
            #{occurredUnlocode},
            #{description},
            'REPORTED',
            #{escalated},
            CURRENT_TIMESTAMP,
            CURRENT_TIMESTAMP
        )
    </insert>

    <update id="markResolved">
        UPDATE tracking_exception
        SET response_status = 'RESOLVED',
            resolution      = #{resolution},
            resolved_at     = #{resolvedAt},
            updated_at      = CURRENT_TIMESTAMP
        WHERE exception_id = #{exceptionId}
    </update>

    <select id="findById" resultMap="trackingExceptionResultMap">
        SELECT *
        FROM tracking_exception
        WHERE exception_id = #{exceptionId}
    </select>

    <select id="findByTrackingNumber" resultMap="trackingExceptionResultMap">
        SELECT *
        FROM tracking_exception
        WHERE tracking_number = #{trackingNumber}
        ORDER BY occurred_at DESC, exception_id ASC
    </select>

    <select id="findAll" resultMap="trackingExceptionResultMap">
        SELECT *
        FROM tracking_exception
        <where>
            <if test="responseStatus != null">
                response_status = #{responseStatus}
            </if>
        </where>
        ORDER BY escalated DESC, occurred_at ASC, exception_id ASC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*) FROM tracking_exception
        <where>
            <if test="responseStatus != null">
                response_status = #{responseStatus}
            </if>
        </where>
    </select>

</mapper>
