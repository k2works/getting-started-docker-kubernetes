<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.cargotracker.bookingms.infrastructure.persistence.ShipperMapper">

    <resultMap id="shipperResultMap" type="com.example.cargotracker.bookingms.infrastructure.persistence.ShipperRecord">
        <id property="id" column="id"/>
        <result property="shipperCode" column="shipper_code"/>
        <result property="shipperType" column="shipper_type"/>
        <result property="name" column="name"/>
        <result property="email" column="email"/>
        <result property="phone" column="phone"/>
        <result property="contractNumber" column="contract_number"/>
        <result property="discountRate" column="discount_rate"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO shipper (shipper_code, shipper_type, name, email, phone, contract_number, discount_rate)
        VALUES (#{shipperCode}, #{shipperType}, #{name}, #{email}, #{phone}, #{contractNumber}, #{discountRate})
    </insert>

    <select id="findByEmail" resultMap="shipperResultMap">
        SELECT * FROM shipper WHERE email = #{email}
    </select>

    <select id="findAll" resultMap="shipperResultMap">
        SELECT * FROM shipper ORDER BY id
    </select>

</mapper>
