<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.cargotracker.trackingms.infrastructure.persistence.TrackingExceptionMapper">

    <resultMap id="trackingExceptionResultMap"
               type="com.example.cargotracker.trackingms.infrastructure.persistence.TrackingExceptionRecord">
        <constructor>
            <idArg column="exception_id"      javaType="String"/>
            <arg   column="tracking_number"   javaType="String"/>
            <arg   column="exception_type"    javaType="String"/>
            <arg   column="occurred_at"       javaType="java.time.LocalDateTime"/>
            <arg   column="occurred_unlocode" javaType="String"/>
            <arg   column="description"       javaType="String"/>
            <arg   column="response_status"   javaType="String"/>
            <arg   column="resolution"        javaType="String"/>
            <arg   column="resolved_at"       javaType="java.time.LocalDateTime"/>
            <arg   column="escalated"         javaType="boolean"/>
            <arg   column="created_at"        javaType="java.time.LocalDateTime"/>
            <arg   column="updated_at"        javaType="java.time.LocalDateTime"/>
        </constructor>
    </resultMap>

    <insert id="insert"
            parameterType="com.example.cargotracker.trackingms.infrastructure.persistence.TrackingExceptionRecord">
        INSERT INTO tracking_exception (
            exception_id, tracking_number, exception_type, occurred_at,
            occurred_unlocode, description, response_status, resolution,
            resolved_at, escalated
        ) VALUES (
            #{exceptionId}, #{trackingNumber}, #{exceptionType}, #{occurredAt},
            #{occurredUnlocode}, #{description}, #{responseStatus}, #{resolution},
            #{resolvedAt}, #{escalated}
        )
    </insert>

    <update id="resolve">
        UPDATE tracking_exception
        SET resolution = #{resolution},
            resolved_at = #{resolvedAt},
            response_status = #{responseStatus},
            updated_at = NOW()
        WHERE exception_id = #{exceptionId}
    </update>

    <select id="findByTrackingNumber" resultMap="trackingExceptionResultMap">
        SELECT * FROM tracking_exception
        WHERE tracking_number = #{trackingNumber}
        ORDER BY occurred_at DESC
    </select>

</mapper>
