<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.cargotracker.trackingms.infrastructure.persistence.TrackingEventMapper">

    <resultMap id="trackingEventResultMap"
               type="com.example.cargotracker.trackingms.infrastructure.persistence.TrackingEventRecord">
        <id property="eventId" column="event_id"/>
        <result property="trackingNumber" column="tracking_number"/>
        <result property="occurredAt" column="occurred_at"/>
        <result property="recordedAt" column="recorded_at"/>
        <result property="eventType" column="event_type"/>
        <result property="transportStatus" column="transport_status"/>
        <result property="unlocode" column="unlocode"/>
        <result property="voyageNumber" column="voyage_number"/>
        <result property="handlingType" column="handling_type"/>
        <result property="description" column="description"/>
        <result property="source" column="source"/>
    </resultMap>

    <insert id="insert"
            parameterType="com.example.cargotracker.trackingms.infrastructure.persistence.TrackingEventRecord">
        INSERT INTO tracking_event (
            tracking_number, occurred_at, recorded_at, event_type,
            transport_status, unlocode, voyage_number, handling_type, description, source
        ) VALUES (
            #{trackingNumber}, #{occurredAt}, CURRENT_TIMESTAMP, #{eventType},
            #{transportStatus}, #{unlocode}, #{voyageNumber}, #{handlingType}, #{description}, #{source}
        )
    </insert>

    <select id="findByTrackingNumberOrderByOccurredAtDesc" resultMap="trackingEventResultMap">
        SELECT * FROM tracking_event
        WHERE tracking_number = #{trackingNumber}
        ORDER BY occurred_at DESC, event_id DESC
    </select>

</mapper>
