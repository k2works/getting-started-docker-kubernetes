<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.cargotracker.handlingms.infrastructure.persistence.CargoStatusHistoryMapper">

    <resultMap id="cargoStatusHistoryResultMap"
               type="com.example.cargotracker.handlingms.infrastructure.persistence.CargoStatusHistoryRecord">
        <id property="historyId" column="history_id"/>
        <result property="trackingNumber" column="tracking_number"/>
        <result property="newStatus" column="new_status"/>
        <result property="unlocode" column="unlocode"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="operatorId" column="operator_id"/>
        <result property="recordedAt" column="recorded_at"/>
    </resultMap>

    <insert id="insert"
            parameterType="com.example.cargotracker.handlingms.infrastructure.persistence.CargoStatusHistoryRecord">
        INSERT INTO cargo_status_history (
            history_id, tracking_number, new_status, unlocode,
            updated_at, operator_id, recorded_at
        ) VALUES (
            #{historyId}, #{trackingNumber}, #{newStatus}, #{unlocode},
            #{updatedAt}, #{operatorId}, CURRENT_TIMESTAMP
        )
    </insert>

    <select id="findByTrackingNumber" resultMap="cargoStatusHistoryResultMap">
        SELECT * FROM cargo_status_history
        WHERE tracking_number = #{trackingNumber}
        ORDER BY updated_at DESC
    </select>

</mapper>
