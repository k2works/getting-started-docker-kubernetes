<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.cargotracker.billingms.infrastructure.persistence.InvoiceMapper">

    <resultMap id="InvoiceResultMap"
               type="com.example.cargotracker.billingms.infrastructure.persistence.InvoiceRecord">
        <id     property="invoiceId"           column="invoice_id"/>
        <result property="bookingId"           column="booking_id"/>
        <result property="shipperId"           column="shipper_id"/>
        <result property="basicAmount"         column="basic_amount"/>
        <result property="discountAmount"      column="discount_amount"/>
        <result property="adjustmentAmount"    column="adjustment_amount"/>
        <result property="totalAmount"         column="total_amount"/>
        <result property="currency"            column="currency"/>
        <result property="billingStatus"       column="billing_status"/>
        <result property="invoiceNumber"       column="invoice_number"/>
        <result property="paymentDue"          column="payment_due"/>
        <result property="paidAt"              column="paid_at"/>
        <result property="cancellationReason"  column="cancellation_reason"/>
        <result property="createdAt"           column="created_at"/>
        <result property="updatedAt"           column="updated_at"/>
        <result property="version"             column="version"/>
    </resultMap>

    <insert id="insert" parameterType="com.example.cargotracker.billingms.infrastructure.persistence.InvoiceRecord">
        INSERT INTO invoice (
            invoice_id, booking_id, shipper_id,
            basic_amount, discount_amount, adjustment_amount, total_amount,
            currency, billing_status, invoice_number,
            payment_due, paid_at, cancellation_reason,
            created_at, updated_at, version
        ) VALUES (
            #{invoiceId}, #{bookingId}, #{shipperId},
            #{basicAmount}, #{discountAmount}, #{adjustmentAmount}, #{totalAmount},
            #{currency}, #{billingStatus}, #{invoiceNumber},
            #{paymentDue}, #{paidAt}, #{cancellationReason},
            CURRENT_TIMESTAMP, CURRENT_TIMESTAMP, 0
        )
    </insert>

    <select id="findById" resultMap="InvoiceResultMap">
        SELECT * FROM invoice WHERE invoice_id = #{invoiceId}
    </select>

    <select id="findAll" resultMap="InvoiceResultMap">
        SELECT * FROM invoice ORDER BY created_at DESC
    </select>

    <select id="findByStatus" resultMap="InvoiceResultMap">
        SELECT * FROM invoice WHERE billing_status = #{billingStatus} ORDER BY created_at DESC
    </select>

    <update id="updateCharge">
        UPDATE invoice SET
            basic_amount    = #{basicAmount},
            discount_amount = #{discountAmount},
            total_amount    = #{totalAmount},
            billing_status  = #{billingStatus},
            updated_at      = CURRENT_TIMESTAMP,
            version         = version + 1
        WHERE invoice_id = #{invoiceId}
    </update>

</mapper>
