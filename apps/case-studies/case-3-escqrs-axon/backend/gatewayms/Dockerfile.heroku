# gatewayms Heroku デプロイ用イメージ
#
# ローカルで bootJar 済みの JAR をコピーして起動するだけの軽量イメージ。

FROM eclipse-temurin:25-jre

RUN groupadd --system --gid 10001 cargo \
    && useradd --system --uid 10001 --gid cargo --create-home cargo

WORKDIR /app

COPY build/libs/gatewayms.jar /app/gatewayms.jar

USER cargo

ENV JAVA_TOOL_OPTIONS=""

ENTRYPOINT ["java", "-jar", "/app/gatewayms.jar"]
