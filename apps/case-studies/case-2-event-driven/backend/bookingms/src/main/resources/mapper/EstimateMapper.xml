<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.bookingms.infrastructure.repositories.EstimateMapper">

    <resultMap id="EstimateRecordMap" type="com.example.bookingms.infrastructure.repositories.EstimateRecord">
        <id     property="id"                   column="id"/>
        <result property="estimateId"           column="estimate_id"/>
        <result property="originUnlocode"       column="origin_unlocode"/>
        <result property="destinationUnlocode"  column="destination_unlocode"/>
        <result property="arrivalDeadline"      column="arrival_deadline"/>
        <result property="cargoType"            column="cargo_type"/>
        <result property="weightKg"             column="weight_kg"/>
        <result property="status"               column="status"/>
        <result property="createdAt"            column="created_at"/>
        <result property="updatedAt"            column="updated_at"/>
    </resultMap>

    <resultMap id="RouteCandidateRecordMap" type="com.example.bookingms.infrastructure.repositories.RouteCandidateRecord">
        <id     property="id"            column="id"/>
        <result property="estimateId"    column="estimate_id"/>
        <result property="voyageNumber"  column="voyage_number"/>
        <result property="transitPort"   column="transit_port"/>
        <result property="transitDays"   column="transit_days"/>
        <result property="estimatedCost" column="estimated_cost"/>
        <result property="rank"          column="rank"/>
        <result property="createdAt"     column="created_at"/>
        <result property="updatedAt"     column="updated_at"/>
    </resultMap>

    <insert id="insertEstimate" parameterType="com.example.bookingms.infrastructure.repositories.EstimateRecord"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO estimate (
            estimate_id, origin_unlocode, destination_unlocode, arrival_deadline,
            cargo_type, weight_kg, status
        ) VALUES (
            #{estimateId}::uuid,
            #{originUnlocode}, #{destinationUnlocode}, #{arrivalDeadline},
            #{cargoType}, #{weightKg}, #{status}
        )
    </insert>

    <insert id="insertRouteCandidate" parameterType="com.example.bookingms.infrastructure.repositories.RouteCandidateRecord"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO route_candidate (
            estimate_id, voyage_number, transit_port, transit_days, estimated_cost, rank
        ) VALUES (
            #{estimateId}, #{voyageNumber}, #{transitPort}, #{transitDays}, #{estimatedCost}, #{rank}
        )
    </insert>

    <select id="findByEstimateId" resultMap="EstimateRecordMap">
        SELECT * FROM estimate WHERE estimate_id = #{estimateId}::uuid
    </select>

    <select id="findCandidatesByEstimateDbId" resultMap="RouteCandidateRecordMap">
        SELECT * FROM route_candidate WHERE estimate_id = #{estimateDbId} ORDER BY rank
    </select>

</mapper>
